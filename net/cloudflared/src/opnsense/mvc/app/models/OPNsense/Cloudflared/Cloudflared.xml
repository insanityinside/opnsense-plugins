<model>
    <mount>//OPNsense/Cloudflared</mount>
    <version>1.0.0</version>
    <description>Cloudflare Tunnel settings</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <token type="TextField">
                <Required>Y</Required>
                <Mask>/^[a-zA-Z0-9\._\-]+$/</Mask>
                <ValidationMessage>Token may only contain letters, digits, dots, underscores and hyphens.</ValidationMessage>
            </token>
            <protocol type="OptionField">
                <Default>auto</Default>
                <Required>Y</Required>
                <OptionValues>
                    <auto/>
                    <quic/>
                    <http2/>
                </OptionValues>
            </protocol>
            <post_quantum type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </post_quantum>
            <quic_disable_pmtu_discovery type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </quic_disable_pmtu_discovery>
            <edge_ip_version type="OptionField">
                <BlankDesc>auto</BlankDesc>
                <OptionValues>
                    <ipv4 value="4">IPv4</ipv4>
                    <ipv6 value="6">IPv6</ipv6>
                </OptionValues>
            </edge_ip_version>
            <icmpv4_src type="TextField">
                <Required>N</Required>
                <Mask>/^$|^((25[0-5]|2[0-4]\d|[01]?\d\d?)\.){3}(25[0-5]|2[0-4]\d|[01]?\d\d?)$/</Mask>
                <ValidationMessage>Must be a valid IPv4 address or empty.</ValidationMessage>
            </icmpv4_src>
            <icmpv6_src type="TextField">
                <Required>N</Required>
                <Mask>/^$|^[0-9a-fA-F:]+$/</Mask>
                <ValidationMessage>Must be a valid IPv6 address or empty.</ValidationMessage>
            </icmpv6_src>
            <log_level type="OptionField">
                <Default>info</Default>
                <Required>Y</Required>
                <OptionValues>
                    <info/>
                    <debug/>
                    <warn/>
                    <error/>
                    <fatal/>
                </OptionValues>
            </log_level>
        </general>
    </items>
</model>
